APP_NAME=AI CareerPilot
APP_VERSION=0.1.0
DEBUG=true
DATABASE_URL=sqlite:///./careerpilot.db
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOADS_DIR=uploads

# AI / LLM configuration. The app runs and degrades gracefully with no key set
# (deterministic template fallbacks are used instead of LLM calls).
# Works with any OpenAI-compatible endpoint (OpenAI, Azure OpenAI, local
# vLLM/Ollama gateways, etc.).
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# NLP / semantic search. Falls back to a scikit-learn HashingVectorizer and a
# NumPy cosine-similarity scan when sentence-transformers/faiss aren't installed.
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_DIR=backend/vector/index_data

# Comma-separated list of allowed frontend origins for CORS.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
